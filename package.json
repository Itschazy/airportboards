{
  "name": "airportboards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-stale-types.mjs && NEXT_DIST_DIR=.next-build next build && node scripts/swap-build.mjs",
    "start": "next start",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:metrica": "node scripts/check-metrica.mjs",
    "check:metrica:built": "node scripts/check-metrica.mjs http://localhost:3002/ru/airport/KZN",
    "check:plurals": "node scripts/check-plurals.mjs",
    "check:board": "node scripts/check-board-logic.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:search": "node scripts/check-search-i18n.mjs",
    "check:collation": "node scripts/check-collation.mjs",
    "check:og": "node scripts/check-og.mjs",
    "derive:names": "node scripts/derive-airport-names.mjs",
    "check:client-messages": "node scripts/check-client-messages.mjs",
    "check:particles": "node scripts/check-particles.mjs",
    "check:fr": "node scripts/check-fr-elision.mjs",
    "check:content-grammar": "node scripts/fix-content-grammar.mjs",
    "check:titles": "node scripts/check-title-duplication.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:sweep": "node scripts/check-locale-sweep.mjs",
    "check:cache": "node scripts/check-cache-headers.mjs",
    "check:shift": "node scripts/check-board-shift.mjs",
    "check:numerals": "node scripts/check-numerals.mjs",
    "check:headers": "node scripts/check-header-scope.mjs",
    "check:pastcard": "node scripts/check-past-flight-card.mjs",
    "check:warmtick": "node scripts/check-warm-tick.mjs",
    "check:track": "node scripts/check-track.mjs",
    "check:status": "node scripts/check-status-codes.mjs",
    "check:boardreg": "node scripts/check-board-regressions.mjs",
    "check:embed": "node scripts/check-embed.mjs",
    "check:sitemapscope": "node scripts/check-sitemap-scope.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "*",
    "lightningcss-darwin-arm64": "*",
    "lightningcss-darwin-x64": "*",
    "@tailwindcss/oxide-linux-x64-gnu": "*",
    "@tailwindcss/oxide-darwin-arm64": "*",
    "@tailwindcss/oxide-darwin-x64": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
